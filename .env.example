# Nome do projeto no compose (chassi do Brain: [[O nome do projeto governa o nome dos recursos]])
COMPOSE_PROJECT_NAME=piwdex

# Porta externa do app (interna e sempre 3000). Par reservado: app 4070 / banco 5070.
APP_PORT=4070
PORT=4070

# Camada 3 (companion logado). Segredo pra criptografar a sessao (tokens do jogo)
# no cookie httpOnly. Gere um: `openssl rand -base64 48`. Obrigatorio pra logar.
SESSION_SECRET=troque-por-um-segredo-aleatorio-longo

# Host da API do jogo (default abaixo). So mude pra apontar pra um mock.
GAME_HOST=https://poke.idleworld.online

# --- Banco (camada 4: login do site). Par de portas: banco 5070. ---
POSTGRES_USER=piwdex
POSTGRES_PASSWORD=piwdex
POSTGRES_DB=piwdex
DB_PORT=5070
# Dev local aponta pro banco publicado na 5070. No compose o app usa piwdex-db:5432.
DATABASE_URL=postgres://piwdex:piwdex@localhost:5070/piwdex

# --- Auth.js (login Google + email/senha). ---
# Segredo pra assinar o JWT da sessao. Gere: `openssl rand -base64 48`.
AUTH_SECRET=troque-por-um-segredo-aleatorio-longo
# Credenciais OAuth do Google (crie em console.cloud.google.com). Sem elas, so
# funciona login por email/senha. Redirect URI: <origem>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
