# Nome do projeto no compose — nao depender do nome da pasta.
COMPOSE_PROJECT_NAME=piwdex2

# Porta publicada do app. A interna e sempre 3000.
# Par reservado do projeto: 4071 (app) / 5071 (banco). O robo e um SEGUNDO
# processo do mesmo projeto e publica na 4072 — duas portas de app, um banco so.
APP_PORT=4071
BOT_PORT=4072

# Porta do `npm run dev`. Rodar noutra porta: PORT=3000 npm run dev
PORT=4071

# ---- papel do processo ----
# `site` = so a dex. `bot` = so o robo. `ambos` = os dois, separados por host.
#
# Em producao sao DOIS servicos a partir da mesma imagem, cada um com o seu
# papel — o robo segura WebSocket e nao pode morrer a cada deploy da dex.
# Ausente em producao vale `site`: esquecer a variavel deixa a dex intacta e o
# robo apagado, que e o unico padrao seguro. Em desenvolvimento vale `ambos`, e
# um `npm run dev` atende localhost:4071 e bot.localhost:4071 ao mesmo tempo
# (o navegador resolve `bot.localhost` sozinho, sem mexer em /etc/hosts).
# PIW_ROLE=ambos

# ---- banco (so o robo usa) ----
DB_PORT=5071
POSTGRES_USER=piwdex2
POSTGRES_PASSWORD=
POSTGRES_DB=piwdex2
# Fora do compose (dev na maquina): a porta publicada.
# Dentro do compose: `piwdex2-db:5432`, nome de servico e porta interna.
DATABASE_URL=postgres://piwdex2:senha@localhost:5071/piwdex2

# ---- segredos da area logada ----
# AUTH_SECRET  cifra o cookie de sessao do site (Auth.js).
# SESSION_SECRET cifra os TOKENS DO JOGO guardados no banco — trocar esta chave
#   invalida todo vinculo existente (o AES-GCM nao decifra e o codigo trata como
#   "sem vinculo"), e cada usuario precisa conectar de novo.
# Gere cada uma com: openssl rand -base64 48
AUTH_SECRET=
SESSION_SECRET=

# Endereco publico do robo. So muda em ambiente de teste.
# NEXT_PUBLIC_BOT_URL=https://bot.piwdex.com.br

# URL canonica do Auth.js no servico do robo (ele monta o callback a partir
# dela). Em producao: https://bot.piwdex.com.br
# AUTH_URL=

# ---- Mercado Pago (assinatura do robo) ----
# Vazio = a tela de assinatura diz que o pagamento esta fora do ar, em vez de
# abrir um checkout que nao existe.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---- AdSense ----
# Vazio = site sem anuncio nenhum: o script do Google nao carrega e nenhum espaco
# e reservado. Preencher so depois de a conta existir e o site estar "Ready".
#
# ATENCAO: `NEXT_PUBLIC_*` e inlinado no `next build`, entao estas variaveis tem
# que estar presentes NA HORA DO BUILD (o compose ja as passa por `build.args`).
# Formato: ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_GRADE=
NEXT_PUBLIC_ADSENSE_SLOT_RODAPE=

# So da unidade de FEED (a da grade): o codigo de ARRANJO que o editor do painel
# gera junto com o slot. Unidade de display nao tem. Sem ele a unidade de feed
# sobe sem erro e nao pinta nada.
NEXT_PUBLIC_ADSENSE_LAYOUT_GRADE=

# ---- Search Console ----
# O token da meta de verificacao (Search Console -> propriedade -> tag HTML).
# Vazio = a meta nao sai. Da pra verificar por DNS tambem, e ai isto fica vazio
# pra sempre.
NEXT_PUBLIC_GOOGLE_VERIFICACAO=

# ---- endereco publico ----
# So precisa mexer em ambiente de teste que nao seja piwdex.com.br: sitemap,
# robots, canonical e metadado social ja saem com o dominio de producao.
# NEXT_PUBLIC_SITE_URL=https://piwdex.com.br
