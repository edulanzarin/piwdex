# Nome do projeto no compose (chassi do Brain: [[O nome do projeto governa o nome dos recursos]])
COMPOSE_PROJECT_NAME=piwdex

# Porta externa do app (interna e sempre 3000). Par reservado: app 4070 / banco 5070.
APP_PORT=4070
PORT=4070

# Camada 3 (companion logado). Segredo pra criptografar a sessao (tokens do jogo)
# no cookie httpOnly. Gere um: `openssl rand -base64 48`. Obrigatorio pra logar.
SESSION_SECRET=troque-por-um-segredo-aleatorio-longo

# Host da API do jogo (default abaixo). So mude pra apontar pra um mock.
GAME_HOST=https://poke.idleworld.online

# --- Banco (camada 4: login do site). Par de portas: banco 5070. ---
POSTGRES_USER=piwdex
POSTGRES_PASSWORD=piwdex
POSTGRES_DB=piwdex
DB_PORT=5070
# Dev local aponta pro banco publicado na 5070. No compose o app usa piwdex-db:5432.
DATABASE_URL=postgres://piwdex:piwdex@localhost:5070/piwdex

# --- Auth.js (login por email/senha). ---
# Segredo pra assinar o JWT da sessao. Gere: `openssl rand -base64 48`.
AUTH_SECRET=troque-por-um-segredo-aleatorio-longo

# --- Area VIP (Mercado Pago, pagamento avulso mensal). ---
# URL publica do site (pras back_urls e o webhook do MP).
APP_URL=http://localhost:4070
# Access token do Mercado Pago. SEM ele, em dev o checkout libera VIP direto (modo
# teste); em producao fica indisponivel. Webhook: <APP_URL>/api/vip/webhook
MP_ACCESS_TOKEN=

# --- Alertas VIP (sniper de mercado). ---
# O sniper roda DENTRO do app (loop interno no boot). Intervalo (s) entre varreduras;
# 60 e um bom equilibrio (o mercado do jogo nao muda mais rapido que isso). 0 desliga.
SCAN_INTERVAL=60
# OPCIONAL: segredo do gatilho manual/externo POST /api/cron/scan (header x-cron-secret).
# Sem ele a rota fica fechada (403) — o loop interno roda do mesmo jeito.
CRON_SECRET=

# =====================================================================
# RAILWAY (producao) — o compose NAO roda la; cada peca vira um servico:
#   - app: este repo (Dockerfile). O railway.json ja faz o pre-deploy
#     `node db/setup.mjs` (migrations) e trava 1 replica (robo/keepalive sao
#     singleton por processo — NUNCA escalar horizontal).
#   - banco: adicione o plugin Postgres do Railway ANTES e referencie a URL
#     privada com ${{Postgres.DATABASE_URL}} (rede interna, sem SSL — ok).
#   - dominio: gere o dominio no servico do app; use ele (ou piwdex.com.br
#     quando apontar o DNS) em APP_URL.
#
# NAO setar no Railway: PORT (o Railway injeta e o app respeita), NODE_ENV
# (ja vem =production do Dockerfile), nem as vars de compose/dev
# (COMPOSE_PROJECT_NAME, APP_PORT, POSTGRES_*, DB_PORT).
#
# ---- COLE no "Raw Editor" das Variables do servico do APP e preencha ----
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# AUTH_SECRET=COLE_AQUI_openssl_rand_base64_48
# SESSION_SECRET=COLE_AQUI_openssl_rand_base64_48
# APP_URL=https://SEU-DOMINIO-DO-RAILWAY
# MP_ACCESS_TOKEN=COLE_AQUI_o_access_token_de_producao_do_mercado_pago
# GAME_HOST=https://poke.idleworld.online
# SCAN_INTERVAL=60
# CRON_SECRET=
# ---- fim do bloco ----
#
# Obrigatorias (o boot aborta sem elas em producao): DATABASE_URL, AUTH_SECRET,
# SESSION_SECRET, APP_URL. Gere os dois secrets com: openssl rand -base64 48
#
# MP_ACCESS_TOKEN: sem ele o checkout VIP fica indisponivel em producao. O webhook
# do Mercado Pago sai AUTOMATICO de APP_URL (<APP_URL>/api/vip/webhook) — nao precisa
# configurar no painel do MP, mas APP_URL TEM que estar certo, senao o pagamento
# aprova e o VIP nao libera. Depois do deploy, teste um PIX real (~R$15,90) ponta a ponta.
# =====================================================================
